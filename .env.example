# ---------------------------------------------------------------- AI Multi-Model Editorial Team
# Provider: groq, gemini, ollama, openai, or anthropic
PEAKCUT_AI_PROVIDER=groq

# Multi-Model Cascade:
# Models run in prioritized order; if one hits rate limits, PapiClips automatically fails over!
# Role mapping: Groq excels at real-time stream scanning (Scout); Gemini excels at viral hooks & titles (Director).
PEAKCUT_AI_MODELS=groq:openai/gpt-oss-120b,groq:qwen/qwen3.8-27b,gemini:gemini-2.0-flash,gemini:gemini-1.5-flash

# Multi-Key Pool (Paste 1 or multiple keys separated by commas for infinite failover)
PEAKCUT_AI_KEY=
PEAKCUT_GROQ_KEYS=
PEAKCUT_GEMINI_KEYS=
PEAKCUT_OLLAMA_KEYS=

# ---------------------------------------------------------------- Server & Networking
PEAKCUT_HOST=127.0.0.1
PEAKCUT_PORT=8765
PEAKCUT_PUBLIC_URL=http://127.0.0.1:8765

# Set to 0 for single-user localhost mode (no password wall). Set to 1 for multi-user signup.
PEAKCUT_ACCOUNTS=0

# ---------------------------------------------------------------- Local Storage
PEAKCUT_DATA=./data

# ---------------------------------------------------------------- Creator Branding & Links
PEAKCUT_FOLLOW_URL=https://www.instagram.com/papig.udda/
PEAKCUT_REPO_URL=

# ---------------------------------------------------------------- Google & YouTube OAuth (For 1-Click Uploading)
# Configured automatically via the web UI, or enter them here:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
